# Supabase (Project Settings -> API). The service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox app (App folder access)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/auth/dropbox/callback
DROPBOX_SUCCESS_REDIRECT=https://YOUR-VERCEL-DOMAIN/?dropbox=connected
DROPBOX_FAILURE_REDIRECT=https://YOUR-VERCEL-DOMAIN/?dropbox=failed

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Encrypts Dropbox tokens in the database.
TOKEN_ENCRYPTION_KEY=

# Receipt scanning. If XAI_API_KEY is set, Grok reads receipts; otherwise Claude does.
XAI_API_KEY=
# Must be a Grok model that accepts images (see console.x.ai -> Models)
XAI_MODEL=grok-4
ANTHROPIC_API_KEY=
# Optional: override the model used for scanning
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Reminder emails
RESEND_API_KEY=
REMINDERS_FROM_EMAIL=

PORT=8080
CRON_TRIGGER_SECRET=
# Comma-separated list of allowed web origins, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# Subscriptions (RevenueCat webhook): send header "Authorization: Bearer <this value>"
REVENUECAT_WEBHOOK_SECRET=
